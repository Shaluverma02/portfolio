# Local MongoDB default. Replace with your Atlas connection URI to use MongoDB Atlas.
#MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=portfolio

# Atlas URI format:
MONGODB_URI=

# Backend API port (optional)
PORT=5500

# Client development server port (optional)
CLIENT_PORT=5173

# Backend API base URL embedded into the client (optional)
VITE_API_URL=http://localhost:5500

# Allowed frontend origin(s), comma-separated (optional)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
