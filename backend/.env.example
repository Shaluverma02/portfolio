# Local MongoDB default. Replace with your Atlas connection URI to use MongoDB Atlas.
#MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=portfolio

# Atlas URI format:
MONGODB_URI=

# Separate server ports (optional)
BACKEND_PORT=5501
# Frontend settings are public configuration; set in your shell if overriding.
# FRONTEND_PORT=5500
# BACKEND_URL=http://127.0.0.1:5501
